{
  "name": "mitka",
  "version": "0.2.0",
  "description": "A dev-only toolbar for Astro sites: pinned page comments Claude Code can read and answer, spacing/size/type inspectors in design px, a layout grid, breakpoint canvas and device preview.",
  "keywords": [
    "astro-integration",
    "withastro",
    "astro",
    "devtools",
    "design-review",
    "feedback",
    "comments",
    "claude-code"
  ],
  "homepage": "https://github.com/zharkodv-cmd/mitka#readme",
  "bugs": {
    "url": "https://github.com/zharkodv-cmd/mitka/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zharkodv-cmd/mitka.git"
  },
  "license": "MIT",
  "author": "Dmitry Zharko",
  "type": "module",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./src/integration.mjs"
    },
    "./client": "./src/client/index.ts",
    "./store": "./src/store/comments.mjs",
    "./presets": {
      "types": "./presets.d.ts",
      "default": "./src/presets.mjs"
    }
  },
  "bin": {
    "mitka": "./bin/mitka.mjs"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "types.d.ts",
    "README.md",
    "presets.d.ts"
  ],
  "scripts": {
    "test": "node bin/mitka.mjs --selftest"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
